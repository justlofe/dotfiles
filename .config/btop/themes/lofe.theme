# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]=""

# Main text color
theme[main_fg]="#cfd8dc"

# Title color for boxes
theme[title]="#ff"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#90"

# Background color of selected item in processes box
# #ffe4eb
theme[selected_bg]="#f36b7f"

# Foreground color of selected item in processes box
theme[selected_fg]="#ff"

# Color of inactive/disabled text
theme[inactive_fg]="#40"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#55bcea"

# Cpu box outline color
theme[cpu_box]="#E93D58"

# Memory/disks box outline color
theme[mem_box]="#E93D58"

# Net up/down box outline color
theme[net_box]="#E93D58"

# Processes box outline color
theme[proc_box]="#E93D58"

# Box divider line and small boxes line color
theme[div_line]="#50"

# Temperature graph colors
theme[temp_start]="#E93D58"
theme[temp_mid]="#e93d85"
theme[temp_end]="#e93d9c"

# CPU graph colors
theme[cpu_start]="#E93D58"
theme[cpu_mid]="#e93d85"
theme[cpu_end]="#e93d9c"

# Mem/Disk free meter
theme[free_start]="#E93D58"
theme[free_mid]="#e93d85"
theme[free_end]="#e93d9c"

# Mem/Disk cached meter
theme[cached_start]="#E93D58"
theme[cached_mid]="#e93d85"
theme[cached_end]="#e93d9c"

# Mem/Disk available meter
theme[available_start]="#e93d9c"
theme[available_mid]="#e93d85"
theme[available_end]="#E93D58"

# Mem/Disk used meter
theme[used_start]="#ff0040"
theme[used_mid]="#e93d85"
theme[used_end]="#e93d9c"

# Download graph colors
theme[download_start]="#E93D58"
theme[download_mid]="#e93d85"
theme[download_end]="#e93d9c"

# Upload graph colors
theme[upload_start]="#E93D58"
theme[upload_mid]="#e93d85"
theme[upload_end]="#e93d9c"
